# API Server Configuration
HTTP_PORT=8080

# Database Configuration
DATABASE_URL=postgres://taskflow:taskflow@postgres:5432/taskflow?sslmode=disable

# NATS Configuration
NATS_URL=nats://nats:4222
NATS_STREAM_NAME=TASKFLOW
NATS_CONSUMER_NAME=taskflow-worker

# Worker Configuration
WORKER_CONCURRENCY=10
WORKER_POLL_TIMEOUT=5s
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_BASE=2s
WORKER_BACKOFF_MAX=5m

# Lease: ack deadline kept alive by heartbeats while a handler runs, plus a
# ceiling that bounds a single attempt. HEARTBEAT_INTERVAL must be < ACK_WAIT.
WORKER_ACK_WAIT=30s
WORKER_HEARTBEAT_INTERVAL=10s
WORKER_MAX_PROCESSING=5m

# Reconciler: periodic sweep that rescues stuck tasks (lost enqueue / crashed
# worker). STALENESS must be > MAX_PROCESSING so in-flight work isn't rescued.
WORKER_RECONCILE_INTERVAL=1m
WORKER_RECONCILE_STALENESS=10m

# Logging
LOG_LEVEL=info
# Options: debug, info, warn, error

# Optional: Custom worker ID (defaults to hostname-pid)
# WORKER_ID=worker-1
# Document pipeline (OCR -> PII -> compliance report)
# Object storage root: document BYTES live here; task payloads/queue/DLQ carry
# references only. Must be shared between API and worker (compose volume).
OBJECTS_DIR=/data/objects

# Observability (docker-compose.prod.yml): Grafana is served publicly at
# /grafana/, so the prod compose refuses to start without this. Only read when
# Grafana first creates its database.
# GRAFANA_ADMIN_PASSWORD=
MAX_UPLOAD_BYTES=26214400
# OCR sub-ceiling: must be < WORKER_MAX_PROCESSING (the whole-task lease ceiling)
WORKER_OCR_TIMEOUT=2m
OCR_LANGS=por+eng
