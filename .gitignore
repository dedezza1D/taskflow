# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html
coverage.txt

# Go workspace file
go.work
go.work.sum

# Dependency directories
vendor/

# Environment variables
.env
.env.local
.env.*.local

# Per-user Claude Code settings (local permissions); launch.json is shared.
.claude/settings.local.json

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
*.iml

# OS specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Build artifacts
bin/
dist/
build/

# Database files
*.db
*.sqlite
*.sqlite3

# Uploads and data
uploads/*
!uploads/.gitkeep
data/*
!data/.gitkeep

# Docker volumes
.docker/

# Documentation builds
docs/_build/
site/
# TLS material. Dev certificates are generated by scripts/gen-dev-certs.sh;
# production keys must never reach the repository.
deploy/nginx/certs/
*.pem
*.key
*.crt

# Desktop build artifacts (generated by scripts/build-desktop.sh)
desktop/src-tauri/target/
desktop/src-tauri/binaries/
desktop/src-tauri/dist/
desktop/src-tauri/tesseract/
desktop/.tessdata-cache/

# Code-signing: a certificate file is a private key, and the merged config the
# build writes carries a signing identity.
*.pfx
*.p12
desktop/src-tauri/.sign.conf.json
