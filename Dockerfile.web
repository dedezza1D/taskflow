# Builds the frontend, then serves it (plus the /api and /grafana proxies)
# from the same nginx used elsewhere in the stack.
FROM node:22-alpine AS build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
