{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskFlow Compliance",
  "version": "0.1.0",
  "identifier": "com.taskflow.compliance",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/taskflow-desktop"],
    "resources": ["dist", "tesseract"],
    "shortDescription": "Find the personal data in your documents",
    "longDescription": "Runs documents through OCR, PII detection and a GDPR/LGPD compliance report entirely on this machine. Nothing is uploaded anywhere.",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": true
    }
  }
}
